<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SQA Hybrid Automation Suite" verbose="1" parallel="false">
    <parameter name="browser" value="chrome"/>
    <parameter name="headless" value="true"/>

    <listeners>
        <listener class-name="com.company.sqa.listeners.ScreenshotListener"/>
        <listener class-name="com.company.sqa.listeners.AnnotationTransformer"/>
    </listeners>

    <test name="API Tests">
        <classes>
            <class name="com.company.sqa.runner.TestRunnerApi"/>
        </classes>
    </test>

    <test name="UI Tests">
        <classes>
            <class name="com.company.sqa.runner.TestRunnerUi"/>
        </classes>
    </test>
</suite>
